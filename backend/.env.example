# Porta HTTP do backend
PORT=3000

# Porta TCP usada pelo rastreador SinoTrack ST-901
TCP_PORT=8090

# URL do Firebase Realtime Database (sem / no final)
FIREBASE_DATABASE_URL=https://your-project.firebaseio.com

# Caminho para o arquivo de credenciais do Firebase Admin SDK
FIREBASE_SERVICE_ACCOUNT_JSON=

# Segredo fora do código para as rotas administrativas
HTTP_API_KEY=
ALLOWED_ORIGINS=https://cirio-app-01.web.app
TCP_MAX_CLIENTS=20
TCP_SOCKET_TIMEOUT_MS=30000
TCP_ALLOWED_IMEIS=

# Raiz onde os dados GPS serão gravados no Realtime Database
FIREBASE_GPS_ROOT=gps
